{
  "name": "packatlas",
  "version": "3.0.0-preview.1",
  "description": "An offline, illustrated archive workbench with a native macOS decoder.",
  "author": "ZHAORUI XIANG",
  "homepage": "https://github.com/CrianeZRX/packatlas",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "package:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.packatlas.desktop",
    "productName": "PackAtlas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "artifactName": "PackAtlas-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "PackAtlas <noreply@github.com>",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "PackAtlas-${version}-windows-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "PackAtlas-${version}-windows-portable-${arch}.${ext}"
    }
  }
}
